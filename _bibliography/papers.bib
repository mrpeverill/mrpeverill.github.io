}

@article{sun_comparison_2022,
	title = {A comparison of methods to harmonize cortical thickness measurements across scanners and sites},
	volume = {261},
	issn = {1053-8119},
	url = {https://www.sciencedirect.com/science/article/pii/S1053811922006255},
	doi = {10.1016/j.neuroimage.2022.119509},
	abstract = {Results of neuroimaging datasets aggregated from multiple sites may be biased by site-specific profiles in participants’ demographic and clinical characteristics, as well as MRI acquisition protocols and scanning platforms. We compared the impact of four different harmonization methods on results obtained from analyses of cortical thickness data: (1) linear mixed-effects model (LME) that models site-specific random intercepts (LMEINT), (2) LME that models both site-specific random intercepts and age-related random slopes (LMEINT+SLP), (3) ComBat, and (4) ComBat with a generalized additive model (ComBat-GAM). Our test case for comparing harmonization methods was cortical thickness data aggregated from 29 sites, which included 1,340 cases with posttraumatic stress disorder (PTSD) (6.2–81.8 years old) and 2,057 trauma-exposed controls without PTSD (6.3–85.2 years old). We found that, compared to the other data harmonization methods, data processed with ComBat-GAM was more sensitive to the detection of significant case-control differences (Χ2(3) = 63.704, p {\textless} 0.001) as well as case-control differences in age-related cortical thinning (Χ2(3) = 12.082, p = 0.007). Both ComBat and ComBat-GAM outperformed LME methods in detecting sex differences (Χ2(3) = 9.114, p = 0.028) in regional cortical thickness. ComBat-GAM also led to stronger estimates of age-related declines in cortical thickness (corrected p-values {\textless} 0.001), stronger estimates of case-related cortical thickness reduction (corrected p-values {\textless} 0.001), weaker estimates of age-related declines in cortical thickness in cases than controls (corrected p-values {\textless} 0.001), stronger estimates of cortical thickness reduction in females than males (corrected p-values {\textless} 0.001), and stronger estimates of cortical thickness reduction in females relative to males in cases than controls (corrected p-values {\textless} 0.001). Our results support the use of ComBat-GAM to minimize confounds and increase statistical power when harmonizing data with non-linear effects, and the use of either ComBat or ComBat-GAM for harmonizing data with linear effects.},
	language = {en},
	urldate = {2022-08-08},
	journal = {NeuroImage},
	author = {Sun, Delin and Rakesh, Gopalkumar and Haswell, Courtney C. and Logue, Mark and Baird, C. Lexi and O'Leary, Erin N. and Cotton, Andrew S. and Xie, Hong and Tamburrino, Marijo and Chen, Tian and Dennis, Emily L. and Jahanshad, Neda and Salminen, Lauren E. and Thomopoulos, Sophia I. and Rashid, Faisal and Ching, Christopher R. K. and Koch, Saskia B. J. and Frijling, Jessie L. and Nawijn, Laura and van Zuiden, Mirjam and Zhu, Xi and Suarez-Jimenez, Benjamin and Sierk, Anika and Walter, Henrik and Manthey, Antje and Stevens, Jennifer S. and Fani, Negar and van Rooij, Sanne J. H. and Stein, Murray and Bomyea, Jessica and Koerte, Inga K. and Choi, Kyle and van der Werff, Steven J. A. and Vermeiren, Robert R. J. M. and Herzog, Julia and Lebois, Lauren A. M. and Baker, Justin T. and Olson, Elizabeth A. and Straube, Thomas and Korgaonkar, Mayuresh S. and Andrew, Elpiniki and Zhu, Ye and Li, Gen and Ipser, Jonathan and Hudson, Anna R. and Peverill, Matthew and Sambrook, Kelly and Gordon, Evan and Baugh, Lee and Forster, Gina and Simons, Raluca M. and Simons, Jeffrey S. and Magnotta, Vincent and Maron-Katz, Adi and du Plessis, Stefan and Disner, Seth G. and Davenport, Nicholas and Grupe, Daniel W. and Nitschke, Jack B. and deRoon-Cassini, Terri A. and Fitzgerald, Jacklynn M. and Krystal, John H. and Levy, Ifat and Olff, Miranda and Veltman, Dick J. and Wang, Li and Neria, Yuval and De Bellis, Michael D. and Jovanovic, Tanja and Daniels, Judith K. and Shenton, Martha and van de Wee, Nic J. A. and Schmahl, Christian and Kaufman, Milissa L. and Rosso, Isabelle M. and Sponheim, Scott R. and Hofmann, David Bernd and Bryant, Richard A. and Fercho, Kelene A. and Stein, Dan J. and Mueller, Sven C. and Hosseini, Bobak and Phan, K. Luan and McLaughlin, Katie A. and Davidson, Richard J. and Larson, Christine L. and May, Geoffrey and Nelson, Steven M. and Abdallah, Chadi G. and Gomaa, Hassaan and Etkin, Amit and Seedat, Soraya and Harpaz-Rotem, Ilan and Liberzon, Israel and van Erp, Theo G. M. and Quidé, Yann and Wang, Xin and Thompson, Paul M. and Morey, Rajendra A.},
	month = nov,
	year = {2022},
	keywords = {PTSD, ComBat, ComBat-GAM, Cortical Thickness, Data Harmonization, General Additive Model, Linear Mixed-Effects Model, Scanner Effects, Site Effects},
	pages = {119509},
	file = {ScienceDirect Snapshot:C\:\\Users\\Peverill\\Zotero\\storage\\VE4UM49G\\S1053811922006255.html:text/html;Submitted Version:C\:\\Users\\Peverill\\Zotero\\storage\\CI3C33ZY\\Sun et al. - 2022 - A comparison of methods to harmonize cortical thic.pdf:application/pdf},
